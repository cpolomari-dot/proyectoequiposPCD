{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Build All",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Configure (Ninja + g++)",
            "type": "shell",
            "command": "cmake -B build -G Ninja -DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
            "problemMatcher": []
        }
    ]
}